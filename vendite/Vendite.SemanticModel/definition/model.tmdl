model Model
	culture: it-IT
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: it-IT
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Calendar","Geography","Product","ProductCategory","ProductSubCategory","Sales","Stores","_misure"]

annotation PBI_ProTooling = ["DevMode"]

ref table Calendar
ref table Geography
ref table Product
ref table ProductCategory
ref table ProductSubCategory
ref table Sales
ref table Stores
ref table _misure

ref cultureInfo it-IT

